{
  "name": "@akal/supaforge",
  "version": "0.0.34",
  "mcpName": "io.github.akalsoftware/supaforge",
  "description": "Diff and sync your Supabase environments",
  "author": "Akal Software Ltd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/akalsoftware/supaforge",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/akalsoftware/supaforge#readme",
  "bugs": {
    "url": "https://github.com/akalsoftware/supaforge/issues"
  },
  "type": "module",
  "bin": {
    "supaforge": "./bin/run.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "bin/run.js",
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "./bin/dev.js",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "./scripts/test-integration.sh",
    "test:e2e": "vitest run test/e2e/",
    "test:e2e:supabase": "./scripts/test-e2e.sh",
    "test:dbdiff-source": "./scripts/test-against-dbdiff-source.sh"
  },
  "oclif": {
    "bin": "supaforge",
    "dirname": "supaforge",
    "commands": {
      "strategy": "pattern",
      "target": "./dist/commands"
    },
    "topics": {
      "migrate": {
        "description": "Create, list and run versioned SQL migrations"
      }
    },
    "helpClass": "./dist/help",
    "topicSeparator": " "
  },
  "dependencies": {
    "@akal/pg-conformance": "~0.0.16",
    "@dbdiff/cli": "3.0.0-rc.28",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@oclif/core": "^4",
    "@supabase/supabase-js": "^2.103.0",
    "libpg-query": "~18.1.5",
    "pg": "^8",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8",
    "tsup": "^8.5.1",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
